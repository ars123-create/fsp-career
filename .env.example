FSP_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
FSP_DATABASE_URL=sqlite:///./data/fsp.db
FSP_FRONTEND_URL=http://127.0.0.1:8018
FSP_DEMO_MODE=true
# Empty SMTP in demo mode uses a private receipt-protected local mailbox.
# Production mode requires SMTP; it never returns a local mailbox receipt.
FSP_SMTP_HOST=
FSP_SMTP_PORT=1026
FSP_SMTP_TLS=false
FSP_SMTP_USER=
FSP_SMTP_PASSWORD=
